# ==========================================
# Dance Studio Environment Configuration Template
# ==========================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (Local or Atlas)
# Example Local: mongodb://127.0.0.1:27017/dance_studio
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/dance_studio
MONGO_URI=mongodb://127.0.0.1:27017/dance_studio

# JWT Secret Key for Session Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Client Application URL (For CORS & Password Reset Links)
CLIENT_URL=http://localhost:5173

# Optional: SMTP Email Service Configuration for Password Reset
EMAIL_SERVICE_HOST=smtp.gmail.com
EMAIL_SERVICE_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Optional: Google OAuth (if enabling Google login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
